# Copy this file to ".env" (same folder) and paste your keys after the equals signs.
# Keys stay on your computer: the local server reads them and they are never sent to the browser.
# Add as many providers as you like. When one hits its limit, the next one takes over automatically.
# Several keys for the same service can be separated by commas (this multiplies a free quota).

# Best quality, also does web research and reads scanned PDFs (paid):
ANTHROPIC_API_KEY=
# Free tiers:
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
# Optional extras:
MISTRAL_API_KEY=
CEREBRAS_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=

# Any OpenAI-compatible service (LM Studio, vLLM, a company gateway ...):
# CUSTOM_BASE_URL=http://127.0.0.1:1234/v1
# CUSTOM_API_KEY=
# CUSTOM_MODEL=
# A model running on your own computer with Ollama (free, no limits):
# OLLAMA_MODEL=llama3.1:8b

# Order providers are tried in (default shown). Remove names to disable them.
# ARCANA_PROVIDERS=claude,gemini,mistral,deepseek,openai,groq,cerebras,openrouter,custom,ollama
# Pin a model for a provider if you want (otherwise the best available one is picked automatically):
# GEMINI_MODEL=
# GROQ_MODEL=
# ARCANA_MODEL=claude-opus-5-5

# Optional: enables "Continue with Google". Create an OAuth Web client at console.cloud.google.com and add your site address under Authorized JavaScript origins.
GOOGLE_CLIENT_ID=

# Optional but recommended on Render free: a free Postgres (neon.tech or supabase.com) so accounts and games survive restarts.
# Paste the connection string, for example postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=

# Support inbox: accounts with these emails (comma separated) can read and manage support tickets in the app.
ADMIN_EMAILS=
# Password-reset and support emails (optional). Any SMTP service works, for example Brevo's free plan or Gmail with an app password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
